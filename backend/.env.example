# Postgres connection string. Neon / Supabase / Render all give you one.
# Hosted databases need ?sslmode=require on the end.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nammapower

PORT=4000
NODE_ENV=development

# Comma-separated emails that become admins when they register
ADMIN_EMAILS=

# Only needed when the frontend is hosted on a DIFFERENT domain than this API
# (e.g. frontend on Netlify, API on Render). Comma-separated origins.
CORS_ORIGIN=
# Cross-domain cookies need SameSite=none (requires HTTPS). Same-domain: leave as lax.
COOKIE_SAMESITE=lax

# Where the built frontend lives. When it exists, this server serves it too,
# so one free host runs the whole app on one domain.
STATIC_DIR=../frontend/dist
